{
  "name": "review-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI code-review dashboard: review Claude Code changes as cards and send the feedback back to the agent",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:fixtures": "node scripts/dev-fixtures.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "fixture": "tsx scripts/make-fixture.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
